<header class="nj-topbar">
  <div class="nj-topbar-left">
    <button class="nj-topbar-toggle" id="sidebar-toggle" aria-label="Alternar menu">
      <i class="ti ti-menu-2"></i>
    </button>
    <nav id="breadcrumb-trail" aria-label="Navegacao estrutural">
      <a class="nj-breadcrumb-item" data-nav="painel" href="#painel">
        <i class="ti ti-home" style="font-size:14px" aria-hidden="true"></i>
      </a>
      <i class="ti ti-chevron-right nj-breadcrumb-sep" aria-hidden="true"></i>
      <span class="nj-breadcrumb-item current">Painel</span>
    </nav>
  </div>
  <div class="nj-topbar-right">
    <div class="nj-topbar-search">
      <i class="ti ti-search nj-topbar-search-icon" aria-hidden="true"></i>
      <input type="text" class="nj-topbar-search-input" id="global-search" placeholder="Buscar processo, cliente..." autocomplete="off" spellcheck="false">
      <span class="nj-topbar-kbd">Ctrl K</span>
    </div>
    <button class="nj-topbar-btn" aria-label="Notificacoes">
      <i class="ti ti-bell"></i>
      <span class="nj-notif-dot"></span>
    </button>
    <button class="nj-topbar-btn" aria-label="Mensagens">
      <i class="ti ti-mail"></i>
    </button>
    <div class="nj-topbar-divider"></div>
    <button class="nj-topbar-theme-toggle" id="theme-toggle" aria-label="Alternar tema">
      <i class="ti ti-moon"></i>
    </button>
  </div>
</header>
