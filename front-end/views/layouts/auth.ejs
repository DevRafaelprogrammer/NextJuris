<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NextJuris — <%= title || 'Autenticacao' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.6.0/dist/tabler-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/navigation.css">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <div class="nj-auth-shell">
    <aside class="nj-auth-brand">
      <div class="nj-auth-brand-top">
        <img src="/logo-icon.svg" alt="NextJuris" style="width:52px;height:52px;margin-bottom:16px">
        <div class="nj-auth-brand-name">NextJuris</div>
        <div class="nj-auth-brand-tagline">Inteligencia artificial aplicada ao direito</div>
        <p class="nj-auth-brand-desc">Plataforma de geracao automatica de relatorios juridicos com precisao tecnica e linguagem forense, alimentada por IA especializada em direito brasileiro.</p>
        <div class="nj-auth-brand-features">
          <div class="nj-auth-feature">
            <div class="nj-auth-feature-icon"><i class="ti ti-sparkles" aria-hidden="true"></i></div>
            <div><div class="nj-auth-feature-title">Geracao com IA</div><div class="nj-auth-feature-desc">Pareceres, pecas e relatorios em minutos.</div></div>
          </div>
          <div class="nj-auth-feature">
            <div class="nj-auth-feature-icon"><i class="ti ti-shield-check" aria-hidden="true"></i></div>
            <div><div class="nj-auth-feature-title">Precisao tecnica</div><div class="nj-auth-feature-desc">97% de acuracia em linguagem forense.</div></div>
          </div>
          <div class="nj-auth-feature">
            <div class="nj-auth-feature-icon"><i class="ti ti-lock" aria-hidden="true"></i></div>
            <div><div class="nj-auth-feature-title">Seguranca total</div><div class="nj-auth-feature-desc">Dados protegidos com criptografia e LGPD.</div></div>
          </div>
        </div>
      </div>
      <div class="nj-auth-brand-bottom">
        <div class="nj-auth-brand-stats">
          <div><div class="nj-auth-stat-value">12k</div><div class="nj-auth-stat-label">Relatorios</div></div>
          <div><div class="nj-auth-stat-value">97%</div><div class="nj-auth-stat-label">Precisao</div></div>
          <div><div class="nj-auth-stat-value">850</div><div class="nj-auth-stat-label">Escritorios</div></div>
        </div>
        <div class="nj-auth-brand-footer"><i class="ti ti-lock" aria-hidden="true"></i> Conexao segura · TLS 1.3 · LGPD</div>
      </div>
    </aside>

    <main class="nj-auth-main">
      <div class="nj-auth-form-wrap">

        <div class="nj-auth-page active" id="auth-login">
          <div class="nj-auth-form-header">
            <div class="nj-auth-eyebrow">Acesso ao sistema</div>
            <h1 class="nj-auth-title">Entrar na sua conta</h1>
            <p class="nj-auth-subtitle">Acesse o painel de geracao de relatorios juridicos.</p>
          </div>
          <div class="nj-auth-alert" id="login-alert"><i class="ti ti-alert-circle" aria-hidden="true"></i><span></span></div>
          <form id="login-form" novalidate>
            <div class="nj-auth-field">
              <label class="nj-auth-label" for="login-email">E-mail ou OAB</label>
              <div class="nj-auth-input-wrap">
                <i class="ti ti-mail nj-auth-input-icon" aria-hidden="true"></i>
                <input type="email" class="nj-auth-input" id="login-email" placeholder="advogado@escritorio.com.br" autocomplete="email" spellcheck="false">
              </div>
              <span class="nj-auth-helper" id="login-email-help"></span>
            </div>
            <div class="nj-auth-field">
              <label class="nj-auth-label" for="login-pass">
                Senha
                <a class="nj-auth-label-link" data-auth-nav="forgot">Esqueceu?</a>
              </label>
              <div class="nj-auth-input-wrap">
                <i class="ti ti-lock nj-auth-input-icon" aria-hidden="true"></i>
                <input type="password" class="nj-auth-input" id="login-pass" placeholder="Sua senha" autocomplete="current-password" style="padding-right:40px">
                <button type="button" class="nj-auth-input-action" id="login-eye" aria-label="Mostrar senha"><i class="ti ti-eye"></i></button>
              </div>
              <span class="nj-auth-helper" id="login-pass-help"></span>
            </div>
            <div class="nj-auth-options">
              <label class="nj-auth-check">
                <input type="checkbox" checked>
                <span class="nj-auth-check-box"><i class="ti ti-check" aria-hidden="true"></i></span>
                Manter conectado
              </label>
            </div>
            <button type="submit" class="nj-auth-submit" id="login-submit" data-label="Entrar no sistema">
              <span class="nj-btn-spinner"></span>
              <span class="nj-auth-submit-label">Entrar no sistema</span>
              <i class="ti ti-arrow-right nj-auth-submit-icon" aria-hidden="true" style="font-size:16px"></i>
            </button>
          </form>
          <div class="nj-auth-divider"><span>ou continue com</span></div>
          <div class="nj-auth-social">
            <button class="nj-auth-social-btn"><i class="ti ti-certificate" aria-hidden="true"></i> Certificado digital (OAB)</button>
            <button class="nj-auth-social-btn"><i class="ti ti-brand-windows" aria-hidden="true"></i> Microsoft 365</button>
          </div>
          <div class="nj-auth-footer">Ainda nao tem acesso? <a class="nj-auth-footer-link" data-auth-nav="register">Solicitar cadastro</a></div>
        </div>

        <div class="nj-auth-page" id="auth-register">
          <a class="nj-auth-back-link" id="reg-back-link" data-auth-nav="login"><i class="ti ti-arrow-left" aria-hidden="true"></i> Voltar ao login</a>
          <div class="nj-auth-form-header">
            <div class="nj-auth-eyebrow" id="reg-eyebrow">Etapa 1 de 3</div>
            <h1 class="nj-auth-title" id="reg-title">Dados pessoais</h1>
            <p class="nj-auth-subtitle" id="reg-subtitle">Informacoes basicas para identificacao no sistema.</p>
          </div>

          <div class="nj-auth-steps" id="reg-stepper">
            <div class="nj-auth-step active" data-step="0"></div>
            <div class="nj-auth-step" data-step="1"></div>
            <div class="nj-auth-step" data-step="2"></div>
          </div>

          <div class="nj-auth-alert" id="reg-alert"><i class="ti ti-circle-check" aria-hidden="true"></i><span></span></div>

          <form id="register-form" novalidate>

            <div id="reg-step-0">
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-name">Nome completo <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-user nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="text" class="nj-auth-input" id="reg-name" name="fullName" placeholder="Dr. Rafael Oliveira da Silva" autocomplete="name" spellcheck="false">
                </div>
                <span class="nj-auth-helper" id="reg-name-help"></span>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-cpf">CPF <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-id nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="text" class="nj-auth-input" id="reg-cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" inputmode="numeric">
                </div>
                <span class="nj-auth-helper" id="reg-cpf-help"></span>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-email">E-mail profissional <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-mail nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="email" class="nj-auth-input" id="reg-email" name="email" placeholder="advogado@escritorio.com.br" autocomplete="email" spellcheck="false">
                </div>
                <span class="nj-auth-helper" id="reg-email-help"></span>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-phone">Telefone <span style="font-weight:400;color:var(--nj-text-muted,#94A1AD);font-size:11px">(opcional)</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-phone nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="tel" class="nj-auth-input" id="reg-phone" name="phone" placeholder="(11) 99999-0000" maxlength="15" inputmode="tel">
                </div>
                <span class="nj-auth-helper" id="reg-phone-help"></span>
              </div>
            </div>

            <div id="reg-step-1" style="display:none">
              <div style="display:grid;grid-template-columns:1fr 100px;gap:8px">
                <div class="nj-auth-field">
                  <label class="nj-auth-label" for="reg-oab">Registro OAB <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                  <div class="nj-auth-input-wrap">
                    <i class="ti ti-certificate nj-auth-input-icon" aria-hidden="true"></i>
                    <input type="text" class="nj-auth-input" id="reg-oab" name="oabNumber" placeholder="123456" maxlength="6" inputmode="numeric">
                  </div>
                  <span class="nj-auth-helper" id="reg-oab-help"></span>
                </div>
                <div class="nj-auth-field">
                  <label class="nj-auth-label" for="reg-oab-state">UF <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                  <div class="nj-auth-input-wrap" style="position:relative">
                    <select class="nj-auth-input" id="reg-oab-state" name="oabState" style="padding-left:12px;padding-right:28px;appearance:none;cursor:pointer">
                      <option value="">UF</option>
                    </select>
                    <i class="ti ti-chevron-down" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--nj-text-muted,#94A1AD);pointer-events:none" aria-hidden="true"></i>
                  </div>
                  <span class="nj-auth-helper" id="reg-oab-state-help"></span>
                </div>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-area">Area de atuacao <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap" style="position:relative">
                  <i class="ti ti-gavel nj-auth-input-icon" aria-hidden="true"></i>
                  <select class="nj-auth-input" id="reg-area" name="area" style="padding-left:38px;padding-right:28px;appearance:none;cursor:pointer">
                    <option value="">Selecionar area</option>
                  </select>
                  <i class="ti ti-chevron-down" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--nj-text-muted,#94A1AD);pointer-events:none" aria-hidden="true"></i>
                </div>
                <span class="nj-auth-helper" id="reg-area-help"></span>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-office">Escritorio / banca <span style="font-weight:400;color:var(--nj-text-muted,#94A1AD);font-size:11px">(opcional)</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-building nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="text" class="nj-auth-input" id="reg-office" name="officeName" placeholder="Oliveira & Associados" spellcheck="false">
                </div>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-comarca">Comarca principal <span style="font-weight:400;color:var(--nj-text-muted,#94A1AD);font-size:11px">(opcional)</span></label>
                <div class="nj-auth-input-wrap" style="position:relative">
                  <i class="ti ti-map-pin nj-auth-input-icon" aria-hidden="true"></i>
                  <select class="nj-auth-input" id="reg-comarca" name="comarca" style="padding-left:38px;padding-right:28px;appearance:none;cursor:pointer">
                    <option value="">Selecionar comarca</option>
                  </select>
                  <i class="ti ti-chevron-down" style="position:absolute;right:8px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--nj-text-muted,#94A1AD);pointer-events:none" aria-hidden="true"></i>
                </div>
              </div>
            </div>

            <div id="reg-step-2" style="display:none">
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-pass">Criar senha <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-lock nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="password" class="nj-auth-input" id="reg-pass" name="password" placeholder="Minimo 8 caracteres" autocomplete="new-password" style="padding-right:40px">
                  <button type="button" class="nj-auth-input-action" id="reg-eye" aria-label="Mostrar senha"><i class="ti ti-eye"></i></button>
                </div>
                <div class="nj-auth-steps" id="reg-strength" style="margin-top:6px">
                  <div class="nj-auth-step"></div>
                  <div class="nj-auth-step"></div>
                  <div class="nj-auth-step"></div>
                  <div class="nj-auth-step"></div>
                </div>
                <span class="nj-auth-helper" id="reg-pass-help"></span>
              </div>
              <div class="nj-auth-field">
                <label class="nj-auth-label" for="reg-pass2">Confirmar senha <span style="color:var(--nj-danger,#C0392B)">*</span></label>
                <div class="nj-auth-input-wrap">
                  <i class="ti ti-lock-check nj-auth-input-icon" aria-hidden="true"></i>
                  <input type="password" class="nj-auth-input" id="reg-pass2" name="confirmPassword" placeholder="Repita a senha" autocomplete="new-password" style="padding-right:40px">
                  <button type="button" class="nj-auth-input-action" id="reg-eye2" aria-label="Mostrar senha"><i class="ti ti-eye"></i></button>
                </div>
                <span class="nj-auth-helper" id="reg-pass2-help"></span>
              </div>
              <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:16px">
                <label class="nj-auth-check">
                  <input type="checkbox" id="reg-terms" name="acceptTerms">
                  <span class="nj-auth-check-box"><i class="ti ti-check" aria-hidden="true"></i></span>
                  Li e aceito os <a class="nj-auth-label-link" href="#">termos de uso</a> e a <a class="nj-auth-label-link" href="#">politica de privacidade</a>
                </label>
                <label class="nj-auth-check">
                  <input type="checkbox" id="reg-lgpd" name="acceptLgpd">
                  <span class="nj-auth-check-box"><i class="ti ti-check" aria-hidden="true"></i></span>
                  Autorizo o tratamento dos meus dados conforme a LGPD
                </label>
                <span class="nj-auth-helper" id="reg-terms-help"></span>
              </div>
            </div>

            <div style="display:flex;gap:8px;margin-top:4px">
              <button type="button" class="nj-auth-social-btn" id="reg-prev-btn" style="display:none;flex:0 0 110px"><i class="ti ti-arrow-left" aria-hidden="true"></i> Voltar</button>
              <button type="button" class="nj-auth-submit" id="reg-next-btn" style="flex:1" data-label="Proximo">
                <span class="nj-btn-spinner"></span>
                <span class="nj-auth-submit-label">Proximo</span>
                <i class="ti ti-arrow-right nj-auth-submit-icon" aria-hidden="true" style="font-size:16px"></i>
              </button>
            </div>
          </form>

          <div class="nj-auth-divider"><span>ou cadastre com</span></div>
          <div class="nj-auth-social">
            <button class="nj-auth-social-btn"><i class="ti ti-certificate" aria-hidden="true"></i> Certificado digital (OAB)</button>
          </div>
          <div class="nj-auth-footer">Ja possui conta? <a class="nj-auth-footer-link" data-auth-nav="login">Entrar no sistema</a></div>
        </div>

        <div class="nj-auth-page" id="auth-forgot">
          <a class="nj-auth-back-link" data-auth-nav="login"><i class="ti ti-arrow-left" aria-hidden="true"></i> Voltar ao login</a>
          <div class="nj-auth-form-header">
            <div class="nj-auth-eyebrow">Recuperar acesso</div>
            <h1 class="nj-auth-title">Redefinir sua senha</h1>
            <p class="nj-auth-subtitle">Informe seu e-mail para receber o link de redefinicao.</p>
          </div>
          <div class="nj-auth-alert" id="forgot-alert"><i class="ti ti-circle-check" aria-hidden="true"></i><span></span></div>
          <form id="forgot-form" novalidate>
            <div class="nj-auth-field">
              <label class="nj-auth-label" for="forgot-email">E-mail cadastrado</label>
              <div class="nj-auth-input-wrap">
                <i class="ti ti-mail nj-auth-input-icon" aria-hidden="true"></i>
                <input type="email" class="nj-auth-input" id="forgot-email" placeholder="advogado@escritorio.com.br" autocomplete="email" spellcheck="false">
              </div>
              <span class="nj-auth-helper" id="forgot-email-help"></span>
            </div>
            <button type="submit" class="nj-auth-submit" id="forgot-submit" data-label="Enviar link">
              <span class="nj-btn-spinner"></span>
              <span class="nj-auth-submit-label">Enviar link de redefinicao</span>
              <i class="ti ti-mail nj-auth-submit-icon" aria-hidden="true" style="font-size:16px"></i>
            </button>
          </form>
          <div class="nj-auth-footer" style="margin-top:24px">Lembrou a senha? <a class="nj-auth-footer-link" data-auth-nav="login">Entrar no sistema</a></div>
        </div>

      </div>
    </main>
  </div>

  <script src="/js/toast.js"></script>
  <script src="/js/api-client.js"></script>
  <script src="/js/input-validator.js"></script>
  <script src="/js/auth-guard.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>
